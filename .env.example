# Copy to .env.local (local) and set the same in Vercel → Project → Settings → Environment Variables.
# docs/deployment.md explains each.

# Supabase project (Project Settings → API). Public: safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_...

# Secret key (Project Settings → API Keys → Secret keys). SERVER ONLY, never NEXT_PUBLIC_.
# Needed for Dashboard → Users (create, delete, set passwords). Without it the rest works.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: email each new enquiry to the business (https://resend.com).
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=
# A sender on a domain verified in Resend; defaults to Resend's test sender.
ENQUIRY_FROM_EMAIL=

# Playwright admin specs (local only): a real staff account on the project above.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
